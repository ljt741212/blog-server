# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=blog_db
DB_SYNCHRONIZE=false
DB_LOGGING=error

# JWT 配置 (生产环境请使用强随机字符串，推荐: openssl rand -hex 64)
JWT_SECRET=change-me-to-a-strong-random-string

# 应用配置
PORT=3004
NODE_ENV=production

# CORS 配置 (多个域名用逗号分隔)
CORS_ORIGIN=https://your-frontend-domain.com

# 邮件配置 (SMTP)
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_smtp_auth_code
EMAIL_FROM=

# 种子管理员账号 — 仅首次运行时使用，已有用户时跳过
# pnpm seed 或 pnpm start:dev 时自动创建
# 生产环境务必设置强密码，创建完成后可删除此配置
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@localhost.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password

# OSS 配置
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket
