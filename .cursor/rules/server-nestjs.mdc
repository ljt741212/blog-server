## NestJS 模块规范

### 模块结构

每个业务模块应包含以下文件：

```
modules/your-module/
├── your-module.module.ts   # 模块定义
├── your-module.controller.ts # 控制器
├── your-module.service.ts   # 服务
├── your-module.entity.ts    # 实体
└── your-module.dto.ts       # DTO
```

### 模块定义

```typescript
import { Module } from '@nestjs/common';
import { TypeOrmModule } from '@nestjs/typeorm';

import { YourEntity } from './your-module.entity';
import { YourController } from './your-module.controller';
import { YourService } from './your-module.service';

@Module({
  imports: [TypeOrmModule.forFeature([YourEntity])],
  controllers: [YourController],
  providers: [YourService],
  exports: [YourService], // 如果其他模块需要使用
})
export class YourModule {}
```

## Controller 规范

### 基本结构

```typescript
import {
  Body,
  Controller,
  Delete,
  Get,
  Param,
  Post,
  Put,
  Query,
  UseGuards,
} from '@nestjs/common';

import { JwtAuthGuard } from '@/common';

import { YourDto, YourPageQueryDto } from './your-module.dto';
import { YourService } from './your-module.service';

@Controller('your-resource')
export class YourController {
  constructor(private readonly yourService: YourService) {}

  @Get('page')
  @UseGuards(JwtAuthGuard)
  paginate(@Query() query: YourPageQueryDto) {
    return this.yourService.paginateForAdmin(query);
  }

  @Post()
  @UseGuards(JwtAuthGuard)
  create(@Body() dto: YourDto) {
    return this.yourService.create(dto);
  }

  @Put(':id')
  @UseGuards(JwtAuthGuard)
  update(@Param('id') id: number, @Body() dto: YourDto) {
    return this.yourService.update(id, dto);
  }

  @Delete(':id')
  @UseGuards(JwtAuthGuard)
  delete(@Param('id') id: number) {
    return this.yourService.delete(id);
  }
}
```

### 路由装饰器

- **GET**: 查询操作
- **POST**: 创建操作
- **PUT**: 更新操作（完整更新）
- **PATCH**: 部分更新
- **DELETE**: 删除操作

### 认证守卫

- 公开接口：不使用 `@UseGuards(JwtAuthGuard)`
- 需要认证：使用 `@UseGuards(JwtAuthGuard)`
- 从请求头获取 token：`@Headers('authorization') authorization?: string`

## Service 规范

### 基本结构

```typescript
import {
  BadRequestException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';

import { paginateQueryBuilderForAdmin } from '@/common';

import { YourDto, YourPageQueryDto } from './your-module.dto';
import { YourEntity } from './your-module.entity';

@Injectable()
export class YourService {
  constructor(
    @InjectRepository(YourEntity)
    private readonly yourRepository: Repository<YourEntity>,
  ) {}

  async paginateForAdmin(query: YourPageQueryDto) {
    const qb = this.yourRepository.createQueryBuilder('your');
    // 查询逻辑
    return paginateQueryBuilderForAdmin(qb, query);
  }

  async create(dto: YourDto) {
    const entity = this.yourRepository.create(dto);
    return this.yourRepository.save(entity);
  }

  async update(id: number, dto: YourDto) {
    const entity = await this.yourRepository.findOne({ where: { id } });
    if (!entity) {
      throw new NotFoundException('资源不存在');
    }
    Object.assign(entity, dto);
    return this.yourRepository.save(entity);
  }

  async delete(id: number) {
    const entity = await this.yourRepository.findOne({ where: { id } });
    if (!entity) {
      throw new NotFoundException('资源不存在');
    }
    await this.yourRepository.remove(entity);
    return { message: '删除成功' };
  }
}
```

### 异常处理

使用 NestJS 内置异常：

- `BadRequestException` - 400 错误请求
- `UnauthorizedException` - 401 未授权
- `NotFoundException` - 404 未找到
- `ConflictException` - 409 冲突
- `InternalServerErrorException` - 500 服务器错误

### 分页查询

使用 `paginateQueryBuilderForAdmin` 工具函数：

```typescript
import { paginateQueryBuilderForAdmin } from '@/common';

async paginateForAdmin(query: YourPageQueryDto) {
  const qb = this.yourRepository.createQueryBuilder('your');
  
  // 添加查询条件
  if (query.searchValue) {
    qb.where('your.name LIKE :search', { search: `%${query.searchValue}%` });
  }
  
  return paginateQueryBuilderForAdmin(qb, query);
}
```

## Entity 规范

### 基本结构

```typescript
import { Column, Entity, ManyToOne, OneToMany } from 'typeorm';

import { CommonEntity } from '@/common/entity/common.entity';
import { RelatedEntity } from '@/modules/related/related.entity';

@Entity('your_table')
export class YourEntity extends CommonEntity {
  @Column({ type: 'varchar', length: 100, comment: '字段说明' })
  name: string;

  @Column({ type: 'varchar', length: 255, nullable: true, comment: '可选字段' })
  description?: string;

  @Column({ type: 'tinyint', default: 1, comment: '状态：0-禁用，1-启用' })
  status: number;

  // 关系
  @ManyToOne(() => RelatedEntity, related => related.yours)
  related: RelatedEntity;

  @OneToMany(() => ChildEntity, child => child.parent)
  children: ChildEntity[];
}
```

### 继承 CommonEntity

所有实体应继承 `CommonEntity`，包含：
- `id`: 主键
- `createdAt`: 创建时间
- `updatedAt`: 更新时间
- `deletedAt`: 软删除时间（可选）

### 列定义

- **类型**: 使用 TypeORM 列类型（`varchar`, `int`, `text`, `tinyint` 等）
- **长度**: 字符串类型指定长度
- **可空**: 使用 `nullable: true`
- **默认值**: 使用 `default`
- **注释**: 使用 `comment` 添加字段说明
- **唯一**: 使用 `unique: true`

## DTO 规范

### 基本结构

```typescript
import { IsString, IsOptional, IsNumber, Min, Max } from 'class-validator';
import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';

export class CreateYourDto {
  @ApiProperty({ description: '名称' })
  @IsString()
  name: string;

  @ApiPropertyOptional({ description: '描述' })
  @IsOptional()
  @IsString()
  description?: string;
}

export class UpdateYourDto {
  @ApiPropertyOptional({ description: '名称' })
  @IsOptional()
  @IsString()
  name?: string;

  @ApiPropertyOptional({ description: '描述' })
  @IsOptional()
  @IsString()
  description?: string;
}

export class YourPageQueryDto {
  @ApiPropertyOptional({ description: '页码', default: 1 })
  @IsOptional()
  @IsNumber()
  @Min(1)
  current?: number;

  @ApiPropertyOptional({ description: '每页数量', default: 10 })
  @IsOptional()
  @IsNumber()
  @Min(1)
  @Max(100)
  pageSize?: number;

  @ApiPropertyOptional({ description: '搜索关键字' })
  @IsOptional()
  @IsString()
  searchValue?: string;
}
```

### 验证装饰器

- `@IsString()` - 字符串验证
- `@IsNumber()` - 数字验证
- `@IsOptional()` - 可选字段
- `@IsEmail()` - 邮箱验证
- `@Min()`, `@Max()` - 数值范围
- `@Length()` - 字符串长度

### Swagger 文档

- `@ApiProperty()` - 必需字段
- `@ApiPropertyOptional()` - 可选字段
- `@ApiTags()` - Controller 标签
- `@ApiOperation()` - 操作说明
- `@ApiResponse()` - 响应说明

## 导入顺序

遵循 ESLint import/order 规则：

1. **NestJS 核心模块** (`@nestjs/common`, `@nestjs/typeorm` 等)
2. **第三方库**（按字母序）
3. **内部别名** (`@/*`)
4. **父级/兄弟/index**
5. **type 导入**

各组之间空一行，组内按字母序排列。

示例：

```typescript
import {
  BadRequestException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import * as bcrypt from 'bcryptjs';
import { Repository } from 'typeorm';

import { paginateQueryBuilderForAdmin } from '@/common';

import { CreateUserDto, UpdateUserDto } from './user.dto';
import { User } from './user.entity';
```

